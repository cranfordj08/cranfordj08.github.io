<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Tile Designer</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f0ede8; color: #1a1a1a; height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
#topbar { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; border-bottom: 1px solid #d0ccc5; background: #fff; flex-wrap: wrap; gap: 8px; flex-shrink: 0; }
#topbar-title { font-size: 15px; font-weight: 600; letter-spacing: -0.02em; color: #1a1a1a; }
#topbar-left { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
#topbar-right { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
.tool-btn { display: inline-flex; align-items: center; gap: 5px; padding: 6px 12px; font-size: 12px; border-radius: 6px; border: 1px solid #d0ccc5; background: #fff; color: #1a1a1a; cursor: pointer; white-space: nowrap; font-family: inherit; transition: background 0.1s; }
.tool-btn:hover { background: #f5f2ee; }
.tool-btn.active { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }
.tool-btn svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
#layout { display: flex; flex: 1; overflow: hidden; }
#sidebar { width: 176px; min-width: 176px; border-right: 1px solid #d0ccc5; background: #fff; padding: 12px 10px; display: flex; flex-direction: column; gap: 14px; overflow-y: auto; flex-shrink: 0; }
.section-label { font-size: 10px; font-weight: 600; color: #999; letter-spacing: 0.08em; text-transform: uppercase; }
#palette { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; }
.color-swatch { width: 100%; aspect-ratio: 1; border-radius: 5px; cursor: pointer; border: 2px solid transparent; transition: transform 0.1s; }
.color-swatch:hover { transform: scale(1.1); }
.color-swatch.selected { border-color: #1a1a1a; box-shadow: 0 0 0 1px #fff inset; }
#saved-colors { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; min-height: 50px; }
.saved-swatch { width: 100%; aspect-ratio: 1; border-radius: 5px; cursor: pointer; border: 2px solid transparent; position: relative; transition: transform 0.1s; }
.saved-swatch:hover { transform: scale(1.08); }
.saved-swatch.selected { border-color: #1a1a1a; box-shadow: 0 0 0 1px #fff inset; }
.saved-swatch .del { display: none; position: absolute; top: -5px; right: -5px; width: 14px; height: 14px; background: #333; color: #fff; border-radius: 50%; font-size: 10px; align-items: center; justify-content: center; line-height: 1; cursor: pointer; z-index: 2; }
.saved-swatch:hover .del { display: flex; }
.no-saved { font-size: 11px; color: #bbb; padding: 2px; grid-column: span 4;}
#custom-row { display: flex; align-items: center; gap: 6px; }
#custom-color { width: 34px; height: 34px; border-radius: 5px; border: 1px solid #d0ccc5; padding: 2px; cursor: pointer; background: none; flex-shrink: 0; }
#add-color-btn { flex: 1; font-size: 11px; padding: 5px 6px; border-radius: 6px; border: 1px solid #d0ccc5; background: #fff; color: #1a1a1a; cursor: pointer; white-space: nowrap; font-family: inherit; }
#add-color-btn:hover { background: #f5f2ee; }
#grid-controls { display: flex; flex-direction: column; gap: 8px; }
.grid-row { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
.grid-row label { font-size: 12px; color: #666; }
.grid-row input[type=number] { width: 54px; padding: 5px 6px; font-size: 12px; border-radius: 5px; border: 1px solid #d0ccc5; background: #fff; color: #1a1a1a; text-align: center; font-family: inherit; }
#apply-grid-btn { width: 100%; font-size: 12px; padding: 7px; border-radius: 6px; border: 1px solid #d0ccc5; background: #fff; color: #1a1a1a; cursor: pointer; font-family: inherit; }
#apply-grid-btn:hover { background: #f5f2ee; }
#canvas-wrap { flex: 1; overflow: auto; background: #2a2a2a; display: flex; align-items: center; justify-content: center; padding: 16px; }
#hex-canvas { display: block; cursor: crosshair; }
#bottombar { display: flex; align-items: center; justify-content: space-between; padding: 7px 14px; border-top: 1px solid #d0ccc5; background: #fff; font-size: 11px; color: #999; flex-shrink: 0; }
</style>
</head>
<body>

<div id="topbar">
  <div style="display:flex;align-items:center;gap:14px;">
    <span id="topbar-title">Tile Mat Designer</span>
    <div id="topbar-left">
      <button class="tool-btn active" id="btn-paint">
        <svg viewBox="0 0 24 24"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
        Paint
      </button>
      <button class="tool-btn" id="btn-erase">
        <svg viewBox="0 0 24 24"><path d="M20 20H7L3 16l10-10 7 7-1.5 1.5"/><path d="M6.5 17.5l5-5"/></svg>
        Erase
      </button>
      <button class="tool-btn" id="btn-fill">
        <svg viewBox="0 0 24 24"><path d="M19 11l-8-8-8.5 8.5a5.5 5.5 0 0 0 7.78 7.78L19 11z"/><path d="M20 23a2 2 0 1 0 4 0c0-1.6-2-3.5-2-3.5s-2 1.9-2 3.5z" transform="translate(-2,-2)"/></svg>
        Fill
      </button>
      <button class="tool-btn" id="btn-eyedrop">
        <svg viewBox="0 0 24 24"><path d="M20 6L14 12"/><path d="M5.5 18.5l-2 2"/><path d="M9 15L4 20H2v-2l5-5"/><path d="M14.5 5.5l4 4-10 10-4-4z"/></svg>
        Pick
      </button>
    </div>
  </div>
  <div id="topbar-right">
    <button class="tool-btn" id="btn-undo">
      <svg viewBox="0 0 24 24"><path d="M9 14L4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg>
      Undo
    </button>
    <button class="tool-btn" id="btn-redo">
      <svg viewBox="0 0 24 24"><path d="M15 14l5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13"/></svg>
      Redo
    </button>
    <button class="tool-btn" id="btn-clear">
      <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
      Clear
    </button>
    <button class="tool-btn" id="btn-save">
      <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Save PNG
    </button>
  </div>
</div>

<div id="layout">
  <div id="sidebar">

    <div class="section-label">Preset colors</div>
    <div id="palette"></div>

    <div class="section-label">Saved colors</div>
    <div id="saved-colors"></div>
    <div id="custom-row">
      <input type="color" id="custom-color" value="#C0392B" title="Pick custom color" />
      <button id="add-color-btn">+ Save color</button>
    </div>

    <div class="section-label">Grid size</div>
    <div id="grid-controls">
      <div class="grid-row">
        <label for="input-cols">Columns</label>
        <input type="number" id="input-cols" min="2" max="80" value="33" />
      </div>
      <div class="grid-row">
        <label for="input-rows">Rows</label>
        <input type="number" id="input-rows" min="2" max="60" value="16" />
      </div>
      <button id="apply-grid-btn">&#8635; Apply (clears grid)</button>
    </div>

  </div>
  <div id="canvas-wrap">
    <canvas id="hex-canvas"></canvas>
  </div>
</div>

<div id="bottombar">
  <span id="hover-info">Hover over a tile to see its position</span>
  <span id="grid-label">33 x 16 hex grid</span>
</div>

<script>
let COLS = 33, ROWS = 16;
const R = 14;
const EMPTY = '#ffffff';
// Flat-top hex: points at left & right, flat edges top & bottom
// col step = 1.5 * R (columns overlap by R/2)
// row step = sqrt(3) * R (rows stack directly)
// odd cols offset DOWN by sqrt(3)*R/2
const COL_STEP = 1.5 * R;
const ROW_STEP = Math.sqrt(3) * R;
const PAD = 6;

const canvas = document.getElementById('hex-canvas');
const ctx = canvas.getContext('2d');

let cells = [];
let activeTool = 'paint';
let activeColor = '#C0392B';
let painting = false;
let history = [];
let historyIndex = -1;
let savedColors = [];

const STORAGE_KEY = 'tile-mat-saved-colors';

function initCells() {
  cells = Array.from({length: ROWS}, () => Array(COLS).fill(EMPTY));
}

function pushHistory() {
  history = history.slice(0, historyIndex + 1);
  history.push(cells.map(r => [...r]));
  if (history.length > 60) history.shift();
  historyIndex = history.length - 1;
}

function hcx(col) {
  return PAD + R + col * COL_STEP;
}
function hcy(col, row) {
  // odd columns shift down by half a row step
  return PAD + ROW_STEP / 2 + row * ROW_STEP + ((col % 2 === 1) ? ROW_STEP / 2 : 0);
}
function canvasW() { return Math.ceil(PAD * 2 + COLS * COL_STEP + R); }
function canvasH() { return Math.ceil(PAD * 2 + ROWS * ROW_STEP + ROW_STEP / 2); }

function drawHex(x, y, color, highlight) {
  ctx.beginPath();
  for (let i = 0; i < 6; i++) {
    const a = Math.PI / 3 * i; // 0° = right point → flat top/bottom
    ctx.lineTo(x + R * Math.cos(a), y + R * Math.sin(a));
  }
  ctx.closePath();
  ctx.fillStyle = color;
  ctx.fill();
  if (highlight) { ctx.fillStyle = 'rgba(255,255,255,0.25)'; ctx.fill(); }
  ctx.strokeStyle = '#1a1a1a';
  ctx.lineWidth = 1.2;
  ctx.stroke();
}

function render(hr, hc) {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  for (let r = 0; r < ROWS; r++)
    for (let c = 0; c < COLS; c++)
      drawHex(hcx(c), hcy(c, r), cells[r][c], r === hr && c === hc);
}

function init() {
  canvas.width = canvasW();
  canvas.height = canvasH();
  history = []; historyIndex = -1;
  pushHistory();
  render();
  document.getElementById('grid-label').textContent = `${COLS} × ${ROWS} hex grid`;
}

function hitTest(x, y) {
  let best = null, bestDist = Infinity;
  for (let r = 0; r < ROWS; r++) {
    for (let c = 0; c < COLS; c++) {
      const d = (x - hcx(c))**2 + (y - hcy(c, r))**2;
      if (d < bestDist) { bestDist = d; best = [r,c]; }
    }
  }
  return best && bestDist < R*R*1.4 ? best : null;
}

function floodFill(startR, startC, target, fill) {
  if (target === fill) return;
  const stack = [[startR, startC]], visited = new Set();
  const nb = (r, c) => {
    const odd = c % 2 === 1;
    return [
      [r-1, c],[r+1, c],
      [r, c-1],[r, c+1],
      [odd ? r+1 : r-1, c-1],
      [odd ? r+1 : r-1, c+1],
    ].filter(([nr,nc]) => nr>=0&&nr<ROWS&&nc>=0&&nc<COLS);
  };
  while (stack.length) {
    const [r,c] = stack.pop();
    const key = r*COLS+c;
    if (visited.has(key)) continue;
    visited.add(key);
    if (cells[r][c] !== target) continue;
    cells[r][c] = fill;
    nb(r,c).forEach(n => stack.push(n));
  }
}

function normalizeHex(hex) {
  return hex.toLowerCase();
}

function applyTool(r, c, isDown) {
  if (activeTool === 'paint') {
    if (normalizeHex(cells[r][c]) !== normalizeHex(activeColor)) { cells[r][c] = activeColor; return true; }
  } else if (activeTool === 'erase') {
    if (cells[r][c] !== EMPTY) { cells[r][c] = EMPTY; return true; }
  } else if (activeTool === 'fill') {
    floodFill(r, c, cells[r][c], activeColor); return true;
  } else if (activeTool === 'eyedrop') {
    setActiveColor(cells[r][c]); setTool('paint'); return false;
  }
  return false;
}

let lastCell = null;
function handlePointer(e, isDown) {
  const rect = canvas.getBoundingClientRect();
  const sx = canvas.width / rect.width, sy = canvas.height / rect.height;
  const x = (e.clientX - rect.left) * sx, y = (e.clientY - rect.top) * sy;
  const hit = hitTest(x, y);
  if (!hit) return;
  const [r,c] = hit;
  document.getElementById('hover-info').textContent = `Row ${r+1}, Col ${c+1}`;
  if (!painting && !isDown) { render(r,c); return; }
  const key = r+','+c;
  if (key === lastCell && activeTool !== 'fill') return;
  lastCell = key;
  const changed = applyTool(r, c, isDown);
  if (changed) { if (isDown) pushHistory(); render(r,c); }
}

canvas.addEventListener('mousedown', e => { painting=true; lastCell=null; handlePointer(e,true); });
canvas.addEventListener('mousemove', e => handlePointer(e,false));
window.addEventListener('mouseup', () => { painting=false; lastCell=null; });
canvas.addEventListener('mouseleave', () => render());
canvas.addEventListener('touchstart', e => { e.preventDefault(); painting=true; lastCell=null; handlePointer(e.touches[0],true); },{passive:false});
canvas.addEventListener('touchmove', e => { e.preventDefault(); handlePointer(e.touches[0],false); },{passive:false});
window.addEventListener('touchend', () => { painting=false; lastCell=null; });

function setTool(t) {
  activeTool = t;
  ['paint','erase','fill','eyedrop'].forEach(n =>
    document.getElementById('btn-'+n).classList.toggle('active', n===t));
}

function setActiveColor(hex) {
  activeColor = hex;
  document.getElementById('custom-color').value = hex;
  document.querySelectorAll('.color-swatch, .saved-swatch').forEach(sw =>
    sw.classList.toggle('selected', normalizeHex(sw.dataset.color) === normalizeHex(hex)));
}

function renderSavedColors() {
  const container = document.getElementById('saved-colors');
  container.innerHTML = '';
  if (savedColors.length === 0) {
    const msg = document.createElement('div');
    msg.className = 'no-saved';
    msg.textContent = 'None saved. Click a color swatch to save it here for later.';
    container.appendChild(msg);
    return;
  }
  savedColors.forEach((hex, idx) => {
    const sw = document.createElement('div');
    sw.className = 'saved-swatch' + (normalizeHex(hex) === normalizeHex(activeColor) ? ' selected' : '');
    sw.style.background = hex;
    sw.style.border = normalizeHex(hex) === '#ffffff' ? '1.5px solid #ccc' : '2px solid transparent';
    sw.dataset.color = hex;
    sw.title = hex;
    sw.addEventListener('click', () => { setActiveColor(hex); setTool('paint'); });
    const del = document.createElement('div');
    del.className = 'del';
    del.textContent = '×';
    del.title = 'Remove';
    del.addEventListener('click', e => {
      e.stopPropagation();
      savedColors.splice(idx, 1);
      saveToStorage();
      renderSavedColors();
    });
    sw.appendChild(del);
    container.appendChild(sw);
  });
}

function saveToStorage() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(savedColors)); } catch(e) {}
}
function loadFromStorage() {
  try {
    const val = localStorage.getItem(STORAGE_KEY);
    if (val) savedColors = JSON.parse(val);
  } catch(e) {}
  renderSavedColors();
}

document.getElementById('add-color-btn').addEventListener('click', () => {
  const hex = document.getElementById('custom-color').value;
  if (!savedColors.map(normalizeHex).includes(normalizeHex(hex))) {
    savedColors.push(hex);
    saveToStorage();
    renderSavedColors();
  }
  setActiveColor(hex);
  setTool('paint');
});

document.getElementById('custom-color').addEventListener('input', e => {
  setActiveColor(e.target.value); setTool('paint');
});

document.getElementById('btn-paint').addEventListener('click', () => setTool('paint'));
document.getElementById('btn-erase').addEventListener('click', () => setTool('erase'));
document.getElementById('btn-fill').addEventListener('click', () => setTool('fill'));
document.getElementById('btn-eyedrop').addEventListener('click', () => setTool('eyedrop'));

document.getElementById('btn-undo').addEventListener('click', () => {
  if (historyIndex > 0) { historyIndex--; const s=history[historyIndex]; for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++) cells[r][c]=s[r][c]; render(); }
});
document.getElementById('btn-redo').addEventListener('click', () => {
  if (historyIndex < history.length-1) { historyIndex++; const s=history[historyIndex]; for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++) cells[r][c]=s[r][c]; render(); }
});
document.getElementById('btn-clear').addEventListener('click', () => {
  if (!confirm('Clear the entire grid?')) return;
  for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++) cells[r][c]=EMPTY;
  pushHistory(); render();
});
document.getElementById('btn-save').addEventListener('click', () => {
  const link = document.createElement('a');
  link.download = 'tile-mat-design.png';
  link.href = canvas.toDataURL('image/png');
  link.click();
});
document.getElementById('apply-grid-btn').addEventListener('click', () => {
  const nc = parseInt(document.getElementById('input-cols').value);
  const nr = parseInt(document.getElementById('input-rows').value);
  if (nc >= 2 && nc <= 80 && nr >= 2 && nr <= 60) {
    if (!confirm(`Resize to ${nc} × ${nr}? This will clear the current design.`)) return;
    COLS = nc; ROWS = nr;
    initCells(); init();
  }
});

const PALETTE_COLORS = [
  '#FFFFFF','#F5F0E8','#E8E0D0','#C8B89A',
  '#2C2C2C','#4A4A4A','#767676','#A8A8A8',
  '#C0392B','#E74C3C','#E8836A','#F0A896',
  '#8B3A3A','#6B2A2A','#3C1010','#1A0808',
  '#E8A020','#F5C842','#F5E090','#FAF0C0',
  '#2E7D32','#4CAF50','#81C784','#C8E6C9',
  '#1565C0','#2196F3','#64B5F6','#BBDEFB',
  '#4A1070','#7B1FA2','#CE93D8','#E1BEE7',
  '#3E7B6E','#5B9E8E','#80B8AE','#B2D8D2',
  '#8B6914','#C49A28','#D4AF55','#E8D090',
];

const paletteEl = document.getElementById('palette');
PALETTE_COLORS.forEach(hex => {
  const sw = document.createElement('div');
  sw.className = 'color-swatch';
  sw.style.background = hex;
  sw.style.border = normalizeHex(hex) === '#ffffff' ? '1.5px solid #ccc' : '2px solid transparent';
  sw.dataset.color = hex;
  sw.title = hex;
  sw.addEventListener('click', () => { setActiveColor(hex); setTool('paint'); });
  paletteEl.appendChild(sw);
});

setActiveColor('#C0392B');
initCells();
init();
loadFromStorage();
</script>
</body>
</html>
